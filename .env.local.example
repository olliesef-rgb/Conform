# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-from-supabase-settings-api
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-from-supabase-settings-api

# ─── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Voyage AI (Embeddings for RAG) ───────────────────────────────────────────
# Sign up free at voyageai.com — Anthropic's recommended embedding partner
# 200M free tokens, then ~$0.12 per 1M tokens
# Processing 343 ITPs + 489 SWMS ≈ ~5-10M tokens ≈ $0.60-1.20 one-time cost
VOYAGE_API_KEY=your-voyage-api-key

# ─── Batch processing (scripts only) ──────────────────────────────────────────
ORG_ID=your-organisation-uuid-from-supabase
ITP_FOLDER=./data/itps     # Path to your 343 ITP PDFs
SWMS_FOLDER=./data/swms    # Path to your 489 SWMS PDFs